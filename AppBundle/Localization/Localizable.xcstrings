    "Das Einrichten formatiert den Dateisystembereich des ausdrücklich verbundenen ESP8266. Dort vorhandene Dateien werden gelöscht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setting up formats the file system area of the ESP8266 you connected. Any files stored there are deleted."
          }
        }
      }
    },
