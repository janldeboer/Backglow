    "Höchstens etwa %@ A statt %@ A bei Vollweiß; helle Bilder werden gleichmäßig abgedunkelt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Höchstens etwa %1$@ A statt %2$@ A bei Vollweiß; helle Bilder werden gleichmäßig abgedunkelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At most about %1$@ A instead of %2$@ A at full white; bright images are dimmed evenly."
          }
        }
      }
    },
