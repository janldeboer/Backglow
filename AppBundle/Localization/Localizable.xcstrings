    "Der Dateisystembereich des verbundenen ESP8266 wird formatiert. Vorhandene Dateien gehen verloren.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file system area of the connected ESP8266 will be formatted. Existing files will be lost."
