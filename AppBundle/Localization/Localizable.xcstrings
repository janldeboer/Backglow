        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Keine Begrenzung. %1$lld LEDs ziehen bei Vollweiß bis etwa %2$@ A."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No limit. %lld LEDs draw up to about %@ A at full white."
          }
        }
      }
    },
